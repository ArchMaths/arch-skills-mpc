@title Claude Chan
# Claude Chan (Claude娘, orange hair and chrysanthemum motif) as a static 3D figure.
# Built from her design sheet: front/side/back views, outfit pieces and accessories.
# Every part is a parametric surface (X,Y,Z,u,u0,u1,v,v0,v1). z is up, she faces -y, and +x is her left.
# Generated by generate.py in this folder: helper functions first, then the head, hair, outfit and props.

# Helpers. fw places a local shape (p,q,r) in a frame: origin o, axes (i,j,k) given per coordinate.
fw(p,q,r,o,i,j,k)=o+p*i+q*j+r*k
# Capsule profile: u runs 0..pi from one end to the other, radius r0 -> r1, rounded ends.
cf(u)=(1-cos(u))/2
cr(u,r0,r1)=(r0+(r1-r0)*cf(u))*sqrt(sqrt(1-cos(u)^4))

//Face
# The head is built from parts: a face shell, the back of the skull, a jaw underside, nose, ears, neck.
# Face shell: for each height h, a superellipse arc from one side of the head around the front to the other.
# fcw(h) is the half-width (it narrows along the jaw to a soft pointed chin), fcy(h) the depth of the
# centre line (the forehead slopes back, the chin comes forward a little), fcs(h) where the arc meets the
# side of the head (moving forward along the jaw), and fcf adds cheek fullness and a slight inset at the eyes.
# fy(p,h) is the y of the face at x=p, so eyes, brows and mouth are painted on as thin decals just in front.
fcw(h)=(0.87-0.06*((h-11.9)/0.85)^2)*max(0,1-(max(0,11.62-h)/0.62)^1.7)^0.55
fcy(h)=-0.9+0.5*max(0,h-12)^2+0.06*(max(0,11.45-h)/0.45)^1.3-0.02*exp(-((h-11.06)/0.05)^2)
fcs(h)=0.2-0.3*(max(0,11.35-h)/0.35)^1.4
fcf(p,h)=0.018*exp(-((abs(p)-0.37)/0.16)^2-((h-11.8)/0.12)^2)-0.015*exp(-((abs(p)-0.47)/0.18)^2-((h-11.5)/0.2)^2)
fy(p,h)=fcs(h)-(fcs(h)-fcy(h))*max(0,1-(p/fcw(h))^2)^0.375+fcf(p,h)
(fcw(h)*sin(f),fcs(h)-(fcs(h)-fcy(h))*abs(cos(f))^0.75+fcf(fcw(h)*sin(f),h),h,f,-pi/2,pi/2,h,11,12.75) | ref=face color=#edb9a3
(0.88*sin(u)*cos(v),0.08+0.98*sin(u)*sin(v),12.0+1.03*cos(u),u,0,pi,v,0,pi) | ref=skull color=#edb9a3
(fw(cr(u,0.19,0.185)*cos(w),1*cr(u,0.19,0.185)*sin(w),1.30138*cf(u),0,1,0,0),fw(cr(u,0.19,0.185)*cos(w),1*cr(u,0.19,0.185)*sin(w),1.30138*cf(u),0.1,0,0.99894,(-0.0461)),fw(cr(u,0.19,0.185)*cos(w),1*cr(u,0.19,0.185)*sin(w),1.30138*cf(u),10.15,0,0.0461,0.99894),w,0,2*pi,u,0,pi) | ref=neck color=#e0a48f
(0+0.3*sin(u)*cos(v),(-0.3)+0.4*sin(u)*sin(v),11.16+0.08*cos(u),u,0,pi,v,0,2*pi) | ref=jaw color=#e0a48f
# Cheap local fits of the face surface (qfit in the generator) for the eye, cheek, nose and mouth
# regions; decals there use them instead of fy.
qeL(p,h)=(-0.80625)+(p-0.4)*(0.50639+(p-0.4)*(0.83508+(p-0.4)*(0.6485+(p-0.4)*(1.42223+(p-0.4)*(2.37364)))))+(h-11.85)*((-0.00326)+(p-0.4)*((-0.01084)+(p-0.4)*(0.0187+(p-0.4)*((-0.0496)+(p-0.4)*((-0.33577)))))+(h-11.85)*(0.02862+(p-0.4)*(0.10873+(p-0.4)*(0.05068+(p-0.4)*(0.53967)))+(h-11.85)*(0.08722+(p-0.4)*((-0.02454)+(p-0.4)*((-2.2207))))))+fcf(p,h)
qeR(p,h)=(-0.80625)+(p-(-0.4))*((-0.50636)+(p-(-0.4))*(0.83528+(p-(-0.4))*((-0.65086)+(p-(-0.4))*(1.41842+(p-(-0.4))*((-2.34193))))))+(h-11.85)*((-0.00326)+(p-(-0.4))*(0.01084+(p-(-0.4))*(0.0187+(p-(-0.4))*(0.0496+(p-(-0.4))*((-0.33579)))))+(h-11.85)*(0.02861+(p-(-0.4))*((-0.10869)+(p-(-0.4))*(0.05088+(p-(-0.4))*((-0.54157))))+(h-11.85)*(0.08722+(p-(-0.4))*(0.02454+(p-(-0.4))*((-2.22094))))))+fcf(p,h)
qbL(p,h)=(-0.8217)+(p-0.36)*(0.44317+(p-0.36)*(0.77051+(p-0.36)*(0.53186+(p-0.36)*(0.99982+(p-0.36)*(1.44613)))))+(h-12.08)*(0.08003+(p-0.36)*(0.00181+(p-0.36)*(0.01566+(p-0.36)*(0.0803+(p-0.36)*(0.17719))))+(h-12.08)*(0.48083+(p-0.36)*((-0.10742)+(p-0.36)*((-0.13619)+(p-0.36)*(0.06703)))+(h-12.08)*((-0.00194)+(p-0.36)*((-0.01087)+(p-0.36)*((-0.01475))))))+fcf(p,h)
qbR(p,h)=(-0.8217)+(p-(-0.36))*((-0.44317)+(p-(-0.36))*(0.77051+(p-(-0.36))*((-0.53186)+(p-(-0.36))*(0.99982+(p-(-0.36))*((-1.44613))))))+(h-12.08)*(0.08003+(p-(-0.36))*((-0.00181)+(p-(-0.36))*(0.01566+(p-(-0.36))*((-0.0803)+(p-(-0.36))*(0.17719))))+(h-12.08)*(0.48083+(p-(-0.36))*(0.10742+(p-(-0.36))*((-0.13619)+(p-(-0.36))*((-0.06703))))+(h-12.08)*((-0.00194)+(p-(-0.36))*(0.01087+(p-(-0.36))*((-0.01475))))))+fcf(p,h)
qcL(p,h)=(-0.73871)+(p-0.5)*(0.74104+(p-0.5)*(1.22318+(p-0.5)*(1.51634+(p-0.5)*(3.57279+(p-0.5)*(7.60588)))))+(h-11.56)*((-0.13562)+(p-0.5)*((-0.7161)+(p-0.5)*((-1.72439)+(p-0.5)*((-4.7366)+(p-0.5)*((-12.69752)))))+(h-11.56)*(0.83338+(p-0.5)*(4.56456+(p-0.5)*(11.23549+(p-0.5)*(21.40176)))+(h-11.56)*(0.27217+(p-0.5)*(0.0191+(p-0.5)*((-4.11204))))))+fcf(p,h)
qcR(p,h)=(-0.73871)+(p-(-0.5))*((-0.74103)+(p-(-0.5))*(1.22327+(p-(-0.5))*((-1.51795)+(p-(-0.5))*(3.56848+(p-(-0.5))*((-7.54611))))))+(h-11.56)*((-0.13562)+(p-(-0.5))*(0.7161+(p-(-0.5))*((-1.72439)+(p-(-0.5))*(4.7366+(p-(-0.5))*((-12.69752)))))+(h-11.56)*(0.83338+(p-(-0.5))*((-4.56449)+(p-(-0.5))*(11.23598+(p-(-0.5))*((-21.41068))))+(h-11.56)*(0.27217+(p-(-0.5))*((-0.0191)+(p-(-0.5))*((-4.11204))))))+fcf(p,h)
qn(p,h)=(-0.90022)+(p-0)*(0+(p-0)*(0.57373+(p-0)*(0+(p-0)*(0.26883))))+(h-11.55)*(0.00449+(p-0)*(0+(p-0)*((-0.44483)+(p-0)*(0+(p-0)*((-0.4486)))))+(h-11.55)*(0.06411+(p-0)*(0+(p-0)*(2.35589))+(h-11.55)*((-0.67026)+(p-0)*(0+(p-0)*((-2.61057))))))+fcf(p,h)
qm(p,h)=(-0.88177)+(p-0)*(0+(p-0)*(0.94147+(p-0)*(0+(p-0)*(0.77173))))+(h-11.27)*((-0.13171)+(p-0)*(0+(p-0)*((-2.57016)+(p-0)*(0+(p-0)*((-5.00979)))))+(h-11.27)*(0.11032+(p-0)*(0+(p-0)*(10.33041))+(h-11.27)*(0.16314+(p-0)*(0+(p-0)*((-44.5847))))))+fcf(p,h)
# Shadow cast by the bangs on the forehead, with a ragged lower edge (it shows between strands).
(p,fy(p,(12.0+0.09*abs(sin(7*p+0.5))+0.06*abs(sin(13*p+1.3))+eta*(12.62-12.0-0.09*abs(sin(7*p+0.5))-0.06*abs(sin(13*p+1.3)))))-0.002,(12.0+0.09*abs(sin(7*p+0.5))+0.06*abs(sin(13*p+1.3))+eta*(12.62-12.0-0.09*abs(sin(7*p+0.5))-0.06*abs(sin(13*p+1.3)))),p,(-0.8),0.8,eta,0,1) | ref=hairShadow color=#e0a48f
# Nose: a narrow ridge rising out of the face to a small tip, then tucking back under it; a soft
# highlight on the tip and the small side shadow anime faces use to suggest the nose.
nh(t)=0.002+0.055*min(t,1)^3*(1-max(0,t-1)/0.25)^0.7
((0.018+0.02*min(t,1))*sin(f),qn((0.018+0.02*min(t,1))*sin(f),(11.66-0.16*min(t,1)-0.05*max(0,t-1)))-nh(t)*abs(cos(f))^1.3,(11.66-0.16*min(t,1)-0.05*max(0,t-1)),t,0,1.25,f,-pi/2,pi/2) | ref=nose color=#edb9a3
((0.018+0.02*min(t,1))*sin(f),qn((0.018+0.02*min(t,1))*sin(f),(11.66-0.16*min(t,1)-0.05*max(0,t-1)))-nh(t)*abs(cos(f))^1.3-0.0015,(11.66-0.16*min(t,1)-0.05*max(0,t-1)),t,0.74,0.95,f,(-0.55),0.25) | ref=noseShine color=#fbe2d8
((-(0.026+0.016*hh)-0.012*q*(1-hh)),qn((-(0.026+0.016*hh)-0.012*q*(1-hh)),(11.6-0.1*hh))-0.002,(11.6-0.1*hh),q,0,1,hh,0,1) | ref=noseShadow color=#d8957f

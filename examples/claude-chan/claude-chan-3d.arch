(0.97*(fwd(h)*sin(f))+0.06976*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.23288)*(h)+2.62314,(-0.06783)*(fwd(h)*sin(f))+0.99756*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.01628*(h)+(-0.18372),0.23345*(fwd(h)*sin(f))+0.97237*(h)+0.31222,f,-pi/2,(-0.36),h,11.66,11.87) | ref=faceEyeRight color=#e5d0cd
(0.97*(fwd(h)*sin(f))+0.06976*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.23288)*(h)+2.62314,(-0.06783)*(fwd(h)*sin(f))+0.99756*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.01628*(h)+(-0.18372),0.23345*(fwd(h)*sin(f))+0.97237*(h)+0.31222,f,(-0.36),0.36,h,11.66,11.87) | ref=faceEyeMid color=#e5d0cd
(0.97*(fwd(h)*sin(f))+0.06976*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.23288)*(h)+2.62314,(-0.06783)*(fwd(h)*sin(f))+0.99756*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.01628*(h)+(-0.18372),0.23345*(fwd(h)*sin(f))+0.97237*(h)+0.31222,f,0.36,pi/2,h,11.66,11.87) | ref=faceEyeLeft color=#e5d0cd
(0.97*(fwd(h)*sin(f))+0.06976*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.23288)*(h)+2.62314,(-0.06783)*(fwd(h)*sin(f))+0.99756*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.01628*(h)+(-0.18372),0.23345*(fwd(h)*sin(f))+0.97237*(h)+0.31222,f,-pi/2,(-0.36),h,11.87,12.51) | ref=faceBrowRight color=#e5d0cd
(0.97*(fwd(h)*sin(f))+0.06976*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.23288)*(h)+2.62314,(-0.06783)*(fwd(h)*sin(f))+0.99756*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.01628*(h)+(-0.18372),0.23345*(fwd(h)*sin(f))+0.97237*(h)+0.31222,f,(-0.36),0.36,h,11.87,12.51) | ref=faceBrowMid color=#e5d0cd
(0.97*(fwd(h)*sin(f))+0.06976*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.23288)*(h)+2.62314,(-0.06783)*(fwd(h)*sin(f))+0.99756*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.01628*(h)+(-0.18372),0.23345*(fwd(h)*sin(f))+0.97237*(h)+0.31222,f,0.36,pi/2,h,11.87,12.51) | ref=faceBrowLeft color=#e5d0cd
# Underside of the jaw: chords between the two sides of the jawline, arched up a little in the middle.
(0.97*(q*fwd(h))+0.06976*(fpl(h)+fd(h))+(-0.23288)*(h+0.05*(1-q^2)*min(1,(h-10.96)/0.2))+2.62314,(-0.06783)*(q*fwd(h))+0.99756*(fpl(h)+fd(h))+0.01628*(h+0.05*(1-q^2)*min(1,(h-10.96)/0.2))+(-0.18372),0.23345*(q*fwd(h))+0.97237*(h+0.05*(1-q^2)*min(1,(h-10.96)/0.2))+0.31222,h,10.96,11.61,q,(-1),1) | ref=jawUnder color=#d2b6b2
# Cranium (under the hair) and neck.
(0.97*(0+0.655*sin(u)*cos(v))+0.06976*(0.14+0.745*sin(u)*sin(v))+(-0.23288)*(12.15+0.755*cos(u))+2.62314,(-0.06783)*(0+0.655*sin(u)*cos(v))+0.99756*(0.14+0.745*sin(u)*sin(v))+0.01628*(12.15+0.755*cos(u))+(-0.18372),0.23345*(0+0.655*sin(u)*cos(v))+0.97237*(12.15+0.755*cos(u))+0.31222,u,0,pi,v,0,2*pi) | ref=cranium color=#e5d0cd

@title Claude Chan
# Claude Chan (Claude娘, orange hair and chrysanthemum motif) as a static 3D figure.
# Built from her design sheet: front/side/back views, outfit pieces and accessories.
# Every part is a parametric surface (X,Y,Z,u,u0,u1,v,v0,v1). z is up, she faces -y, and +x is her left.
# Generated by generate.py in this folder: helper functions first, then the head, hair, outfit and props.

# Helpers. fw places a local shape (p,q,r) in a frame: origin o, axes (i,j,k) given per coordinate.
fw(p,q,r,o,i,j,k)=o+p*i+q*j+r*k
# Capsule profile: u runs 0..pi from one end to the other, radius r0 -> r1, rounded ends.
cf(u)=(1-cos(u))/2
cr(u,r0,r1)=(r0+(r1-r0)*cf(u))*sqrt(sqrt(1-cos(u)^4))

//Head
# The head is sculpted from parts: a face mask, the cranium under the hair, the underside of the jaw,
# the neck and the ears. The face mask is a stack of horizontal arcs, one per height h. Each arc runs from the
# side of the head around the front to the other side: half-width fwd(h), depth fd(h), and a superellipse
# exponent fq(h) that makes it boxy across the eyes (a flat front that turns quickly at the cheekbones) and
# rounder along the jaw. fpl(h) is the profile of the face seen from the side (forehead, the dip between the
# eyes, the plane of the cheeks and mouth, chin). fr adds what is narrower than the whole face: the nose,
# lips, chin, cheeks, brow and eye sockets. fy(p,h) is the y of the skin at x=p, z=h.
smn(a,b,c)=(a+b-sqrt((a-b)^2+c^2))/2
fpl(h)=(-0.44)+(-2.4291)*(h-11.02)+670.60212*max(0,h-11.02)^3+(-965.35629)*max(0,h-11.037)^3+307.26049*max(0,h-11.075)^3+(-38.24542)*max(0,h-11.13)^3+53.38016*max(0,h-11.2)^3+(-35.43585)*max(0,h-11.26)^3+12.28961*max(0,h-11.35)^3+(-10.12446)*max(0,h-11.465)^3+5.20106*max(0,h-11.58)^3+(-6.00616)*max(0,h-11.68)^3+15.07437*max(0,h-11.76)^3+(-8.61217)*max(0,h-11.85)^3+0.27111*max(0,h-11.95)^3+(-0.18258)*max(0,h-12.11)^3+0.22672*max(0,h-12.25)^3+(-1.88502)*max(0,h-12.39)^3
fwd(h)=smn(smn(0.645,0.69*sqrt(max(0,1-(max(0,h-12.03)/0.86)^2)),0.04),1.05*sqrt(max(0,(h-11.02)*(h-10.92))),0.1)
fd(h)=smn(0.1-fpl(h),1.25*fwd(h),0.08)
fq(h)=0.3-0.115*exp(-((h-11.7)/0.2)^2)+0.1/(1+exp((h-11.23)/0.06))
fno(h)=0.07*exp(-(max(0,h-11.495)/0.075)^1.4-(max(0,11.495-h)/0.03)^2)
fr(p,h)=-fno(h)*exp(-(p/(0.024+0.022*exp(-((h-11.485)/0.05)^2)))^2)-0.008*exp(-((h-11.48)/0.06)^2-(p/0.1)^2)-0.008*exp(-((h-11.34)/0.03)^2-(p/0.085)^2)+0.006*exp(-((h-11.305)/0.012)^2-(p/0.08)^2)-0.008*exp(-((h-11.265)/0.028)^2-(p/0.065)^2)-0.006*exp(-((h-11.12)/0.06)^2-(p/0.1)^2)+0.02*exp(-((abs(p)-0.33)/0.17)^2-((h-11.75)/0.1)^2)-0.008*exp(-((abs(p)-0.3)/0.2)^2-((h-11.97)/0.07)^2)-0.02*exp(-((abs(p)-0.3)/0.17)^2-((h-11.49)/0.15)^2)
fy(p,h)=fpl(h)+fd(h)*(1-max(0,1-(p/fwd(h))^2)^fq(h))+fr(p,h)
# The mask is drawn as six patches of the same surface, so the nose, lips and chin get a finer
# mesh than the cheeks and forehead. Patches share their edges exactly, so no seam shows.
(fwd(h)*sin(f),fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h),h,f,(-0.36),0.36,h,11.02,11.87) | ref=faceMid color=#e4beb4
(fwd(h)*sin(f),fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h),h,f,0.36,pi/2,h,11.02,11.87) | ref=faceLeft color=#e4beb4
(fwd(h)*sin(f),fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h),h,f,-pi/2,(-0.36),h,11.02,11.87) | ref=faceRight color=#e4beb4
(fwd(h)*sin(f),fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h),h,f,(-0.36),0.36,h,11.87,12.51) | ref=browMid color=#e4beb4
(fwd(h)*sin(f),fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h),h,f,0.36,pi/2,h,11.87,12.51) | ref=browLeft color=#e4beb4
(fwd(h)*sin(f),fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h),h,f,-pi/2,(-0.36),h,11.87,12.51) | ref=browRight color=#e4beb4
# Underside of the jaw: chords between the two sides of the jawline, arched up a little in the middle.
(q*fwd(h),fpl(h)+fd(h),h+0.05*(1-q^2)*min(1,(h-11.02)/0.2),h,11.02,11.61,q,(-1),1) | ref=jawUnder color=#d3a79c
# Cranium (under the hair) and neck.
(0+0.655*sin(u)*cos(v),0.14+0.745*sin(u)*sin(v),12.15+0.755*cos(u),u,0,pi,v,0,2*pi) | ref=cranium color=#e4beb4
(fwd(h)*cos(g),0.1+0.3*sin(g),h,g,0,pi,h,11.43,12.23) | ref=headSide color=#e4beb4
(fw(cr(u,0.2,0.205)*cos(w),1*cr(u,0.2,0.205)*sin(w),1.32306*cf(u),0,1,0,0),fw(cr(u,0.2,0.205)*cos(w),1*cr(u,0.2,0.205)*sin(w),1.32306*cf(u),0.04,0,0.99768,(-0.06802)),fw(cr(u,0.2,0.205)*cos(w),1*cr(u,0.2,0.205)*sin(w),1.32306*cf(u),10.2,0,0.06802,0.99768),w,0,2*pi,u,0,pi) | ref=neck color=#d3a79c
# Ears: a dished shell with a rolled helix, an inner fold, the concha, tragus and lobe.
(fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),0.0112+0.024*r^6-0.0096*(1-r^2),0.612,(-0.37046),(-0.11272),0.92198),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),0.0112+0.024*r^6-0.0096*(1-r^2),0.23,0.88206,0.26837,0.38723),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),0.0112+0.024*r^6-0.0096*(1-r^2),11.685,(-0.29108),0.9567,0),r,0,1,w,0,2*pi) | ref=earL color=#e4beb4
(fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),-0.0032-0.0096*(1-r^2),0.612,(-0.37046),(-0.11272),0.92198),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),-0.0032-0.0096*(1-r^2),0.23,0.88206,0.26837,0.38723),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),-0.0032-0.0096*(1-r^2),11.685,(-0.29108),0.9567,0),w,0,2*pi,r,0,1) | ref=earBackL color=#d3a79c
(fw((0.084+0.016*cos(v))*cos(w)*(1+0.25*sin(w))-0.008,(0.16+0.016*cos(v))*sin(w),0.0336+0.016*sin(v),0.612,(-0.37046),(-0.11272),0.92198),fw((0.084+0.016*cos(v))*cos(w)*(1+0.25*sin(w))-0.008,(0.16+0.016*cos(v))*sin(w),0.0336+0.016*sin(v),0.23,0.88206,0.26837,0.38723),fw((0.084+0.016*cos(v))*cos(w)*(1+0.25*sin(w))-0.008,(0.16+0.016*cos(v))*sin(w),0.0336+0.016*sin(v),11.685,(-0.29108),0.9567,0),w,(-1.75),2.05,v,0,2*pi) | ref=earHelixL color=#e4beb4
(fw((0.048+0.0096*cos(v))*cos(w)*(1+0.25*sin(w))+0.004,(0.096+0.0096*cos(v))*sin(w)+0.008,0.024+0.0096*sin(v),0.612,(-0.37046),(-0.11272),0.92198),fw((0.048+0.0096*cos(v))*cos(w)*(1+0.25*sin(w))+0.004,(0.096+0.0096*cos(v))*sin(w)+0.008,0.024+0.0096*sin(v),0.23,0.88206,0.26837,0.38723),fw((0.048+0.0096*cos(v))*cos(w)*(1+0.25*sin(w))+0.004,(0.096+0.0096*cos(v))*sin(w)+0.008,0.024+0.0096*sin(v),11.685,(-0.29108),0.9567,0),w,(-1.1),1.7,v,0,2*pi) | ref=earFoldL color=#e4beb4
(fw(0.04*r*cos(w)-0.004,0.06*r*sin(w)-0.028,0.0128,0.612,(-0.37046),(-0.11272),0.92198),fw(0.04*r*cos(w)-0.004,0.06*r*sin(w)-0.028,0.0128,0.23,0.88206,0.26837,0.38723),fw(0.04*r*cos(w)-0.004,0.06*r*sin(w)-0.028,0.0128,11.685,(-0.29108),0.9567,0),r,0,1,w,0,2*pi) | ref=earConchaL color=#c9958a
(fw(0.0176*sin(u)*cos(v),0.024*sin(u)*sin(v),0.0176*cos(u),0.64434,(-0.37046),(-0.11272),0.92198),fw(0.0176*sin(u)*cos(v),0.024*sin(u)*sin(v),0.0176*cos(u),0.15299,0.88206,0.26837,0.38723),fw(0.0176*sin(u)*cos(v),0.024*sin(u)*sin(v),0.0176*cos(u),11.68533,(-0.29108),0.9567,0),u,0,pi,v,0,2*pi) | ref=earTragusL color=#e4beb4
(fw(0.036*sin(u)*cos(v),0.04*sin(u)*sin(v),0.024*cos(u),0.62913,(-0.37046),(-0.11272),0.92198),fw(0.036*sin(u)*cos(v),0.04*sin(u)*sin(v),0.024*cos(u),0.18921,0.88206,0.26837,0.38723),fw(0.036*sin(u)*cos(v),0.04*sin(u)*sin(v),0.024*cos(u),11.53958,(-0.29108),0.9567,0),u,0,pi,v,0,2*pi) | ref=earLobeL color=#e4beb4
(fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),0.0112+0.024*r^6-0.0096*(1-r^2),(-0.612),0.37046,0.11272,(-0.92198)),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),0.0112+0.024*r^6-0.0096*(1-r^2),0.23,0.88206,0.26837,0.38723),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),0.0112+0.024*r^6-0.0096*(1-r^2),11.685,(-0.29108),0.9567,0),w,0,2*pi,r,0,1) | ref=earR color=#e4beb4
(fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),-0.0032-0.0096*(1-r^2),(-0.612),0.37046,0.11272,(-0.92198)),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),-0.0032-0.0096*(1-r^2),0.23,0.88206,0.26837,0.38723),fw(0.084*r*cos(w)*(1+0.25*sin(w))-0.008,0.16*r*sin(w),-0.0032-0.0096*(1-r^2),11.685,(-0.29108),0.9567,0),r,0,1,w,0,2*pi) | ref=earBackR color=#d3a79c
(fw((0.084+0.016*cos(v))*cos(w)*(1+0.25*sin(w))-0.008,(0.16+0.016*cos(v))*sin(w),0.0336+0.016*sin(v),(-0.612),0.37046,0.11272,(-0.92198)),fw((0.084+0.016*cos(v))*cos(w)*(1+0.25*sin(w))-0.008,(0.16+0.016*cos(v))*sin(w),0.0336+0.016*sin(v),0.23,0.88206,0.26837,0.38723),fw((0.084+0.016*cos(v))*cos(w)*(1+0.25*sin(w))-0.008,(0.16+0.016*cos(v))*sin(w),0.0336+0.016*sin(v),11.685,(-0.29108),0.9567,0),v,0,2*pi,w,(-1.75),2.05) | ref=earHelixR color=#e4beb4
(fw((0.048+0.0096*cos(v))*cos(w)*(1+0.25*sin(w))+0.004,(0.096+0.0096*cos(v))*sin(w)+0.008,0.024+0.0096*sin(v),(-0.612),0.37046,0.11272,(-0.92198)),fw((0.048+0.0096*cos(v))*cos(w)*(1+0.25*sin(w))+0.004,(0.096+0.0096*cos(v))*sin(w)+0.008,0.024+0.0096*sin(v),0.23,0.88206,0.26837,0.38723),fw((0.048+0.0096*cos(v))*cos(w)*(1+0.25*sin(w))+0.004,(0.096+0.0096*cos(v))*sin(w)+0.008,0.024+0.0096*sin(v),11.685,(-0.29108),0.9567,0),v,0,2*pi,w,(-1.1),1.7) | ref=earFoldR color=#e4beb4
(fw(0.04*r*cos(w)-0.004,0.06*r*sin(w)-0.028,0.0128,(-0.612),0.37046,0.11272,(-0.92198)),fw(0.04*r*cos(w)-0.004,0.06*r*sin(w)-0.028,0.0128,0.23,0.88206,0.26837,0.38723),fw(0.04*r*cos(w)-0.004,0.06*r*sin(w)-0.028,0.0128,11.685,(-0.29108),0.9567,0),w,0,2*pi,r,0,1) | ref=earConchaR color=#c9958a
(fw(0.0176*sin(u)*cos(v),0.024*sin(u)*sin(v),0.0176*cos(u),(-0.64434),0.37046,0.11272,(-0.92198)),fw(0.0176*sin(u)*cos(v),0.024*sin(u)*sin(v),0.0176*cos(u),0.15299,0.88206,0.26837,0.38723),fw(0.0176*sin(u)*cos(v),0.024*sin(u)*sin(v),0.0176*cos(u),11.68533,(-0.29108),0.9567,0),v,0,2*pi,u,0,pi) | ref=earTragusR color=#e4beb4
(fw(0.036*sin(u)*cos(v),0.04*sin(u)*sin(v),0.024*cos(u),(-0.62913),0.37046,0.11272,(-0.92198)),fw(0.036*sin(u)*cos(v),0.04*sin(u)*sin(v),0.024*cos(u),0.18921,0.88206,0.26837,0.38723),fw(0.036*sin(u)*cos(v),0.04*sin(u)*sin(v),0.024*cos(u),11.53958,(-0.29108),0.9567,0),v,0,2*pi,u,0,pi) | ref=earLobeR color=#e4beb4

//Eyes
# Local polynomial fits of the face surface (qfit in the generator) for the eye and brow regions.
# Arch expands functions as text, so decals use these instead of the full fy.
qeL(p,h)=(-0.50584)+(p-0.375)*(0.29519+(p-0.375)*(0.34873+(p-0.375)*(4.2151+(p-0.375)*(16.7466+(p-0.375)*((-49.12904)+(p-0.375)*((-217.91219)+(p-0.375)*(1222.56695+(p-0.375)*(4776.74376))))))))+(h-11.745)*(0.08466+(p-0.375)*(0.1187+(p-0.375)*((-0.66252)+(p-0.375)*(4.78326+(p-0.375)*(33.33697+(p-0.375)*((-12.77096)+(p-0.375)*((-676.75445)+(p-0.375)*((-1576.74357))))))))+(h-11.745)*((-2.52095)+(p-0.375)*(11.79849+(p-0.375)*(63.0655+(p-0.375)*((-164.85858)+(p-0.375)*((-593.20342)+(p-0.375)*(2280.49432+(p-0.375)*(6184.84694))))))+(h-11.745)*((-2.9184)+(p-0.375)*((-8.98462)+(p-0.375)*((-14.77756)+(p-0.375)*((-57.06875)+(p-0.375)*((-1624.10657)+(p-0.375)*((-6632.39661))))))+(h-11.745)*(71.80979+(p-0.375)*((-219.85774)+(p-0.375)*((-1209.46722)+(p-0.375)*(4148.80557+(p-0.375)*(15774.84022))))))))
qeR(p,h)=(-0.50584)+(p-(-0.375))*((-0.29519)+(p-(-0.375))*(0.34873+(p-(-0.375))*((-4.2151)+(p-(-0.375))*(16.7466+(p-(-0.375))*(49.12904+(p-(-0.375))*((-217.91219)+(p-(-0.375))*((-1222.56695)+(p-(-0.375))*(4776.74376))))))))+(h-11.745)*(0.08466+(p-(-0.375))*((-0.1187)+(p-(-0.375))*((-0.66252)+(p-(-0.375))*((-4.78326)+(p-(-0.375))*(33.33697+(p-(-0.375))*(12.77096+(p-(-0.375))*((-676.75445)+(p-(-0.375))*(1576.74357)))))))+(h-11.745)*((-2.52095)+(p-(-0.375))*((-11.79849)+(p-(-0.375))*(63.0655+(p-(-0.375))*(164.85858+(p-(-0.375))*((-593.20342)+(p-(-0.375))*((-2280.49432)+(p-(-0.375))*(6184.84694))))))+(h-11.745)*((-2.9184)+(p-(-0.375))*(8.98462+(p-(-0.375))*((-14.77756)+(p-(-0.375))*(57.06875+(p-(-0.375))*((-1624.10657)+(p-(-0.375))*(6632.39661)))))+(h-11.745)*(71.80979+(p-(-0.375))*(219.85774+(p-(-0.375))*((-1209.46722)+(p-(-0.375))*((-4148.80557)+(p-(-0.375))*(15774.84022))))))))
qbL(p,h)=(-0.54497)+(p-0.355)*(0.46586+(p-0.355)*(1.2438+(p-0.355)*(1.85513+(p-0.355)*((-1.09127)+(p-0.355)*((-8.77568)+(p-0.355)*(143.34943+(p-0.355)*(535.5022)))))))+(h-11.955)*((-0.0821)+(p-0.355)*(0.56622+(p-0.355)*(2.01844+(p-0.355)*((-1.27792)+(p-0.355)*((-9.53267)+(p-0.355)*(7.20858+(p-0.355)*(15.22719))))))+(h-11.955)*(1.17707+(p-0.355)*((-4.52612)+(p-0.355)*((-27.42441)+(p-0.355)*(52.45459+(p-0.355)*(162.45187+(p-0.355)*((-425.54795))))))+(h-11.955)*(2.38941+(p-0.355)*((-7.15411)+(p-0.355)*((-23.08897)+(p-0.355)*(102.85612+(p-0.355)*(77.88445)))))))
qbR(p,h)=(-0.54497)+(p-(-0.355))*((-0.46586)+(p-(-0.355))*(1.2438+(p-(-0.355))*((-1.85513)+(p-(-0.355))*((-1.09127)+(p-(-0.355))*(8.77568+(p-(-0.355))*(143.34943+(p-(-0.355))*((-535.5022))))))))+(h-11.955)*((-0.0821)+(p-(-0.355))*((-0.56622)+(p-(-0.355))*(2.01844+(p-(-0.355))*(1.27792+(p-(-0.355))*((-9.53267)+(p-(-0.355))*((-7.20858)+(p-(-0.355))*(15.22719))))))+(h-11.955)*(1.17707+(p-(-0.355))*(4.52612+(p-(-0.355))*((-27.42441)+(p-(-0.355))*((-52.45459)+(p-(-0.355))*(162.45187+(p-(-0.355))*(425.54795)))))+(h-11.955)*(2.38941+(p-(-0.355))*(7.15411+(p-(-0.355))*((-23.08897)+(p-(-0.355))*((-102.85612)+(p-(-0.355))*(77.88445)))))))
# Her eyes are long and half-lidded: a heavy, nearly level upper lash line that ends in a wing, and a
# bowl-shaped lower lid. xi runs across an eye from the inner corner (-1) to the outer corner (+1);
# eu and el are the heights of the upper and lower lid above the corner line, lw and lv the lower and
# upper edge of the lash line (which continues past the corner into the wing).
# Layers, back to front: eye white, the lid's shadow, iris (dark rim, amber, shaded under the lid, golden
# below), pupil, highlights, then the lash line, lashes, lower lid line, the fold of the lid and the brow.
eu(xi)=0.024*(1-min(1,abs(xi))^2.5)^0.6+0.006*xi
el(xi)=-0.126*(1-min(1,xi^2))^0.62*(1+0.12*xi)+0.006*xi
lw(xi)=eu(min(xi,1))+0.04*(max(0,xi-1)/0.32)^1.5
lv(xi)=eu(min(xi,1))+(0.012+0.022*min(1,max(0,xi+0.9)/0.9)+0.014*min(1,max(0,xi-0.5)/0.5))*min(1,(xi+1)/0.12)^0.5-0.004*max(0,xi-1)/0.32

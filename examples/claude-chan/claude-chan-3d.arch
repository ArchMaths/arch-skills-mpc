(fw(0.115*r*cos(w)-0.01,0.2*r*sin(w),0.014+0.03*r^6-0.012*(1-r^2),0.87,(-0.17079),(-0.04706),0.98418),fw(0.115*r*cos(w)-0.01,0.2*r*sin(w),0.014+0.03*r^6-0.012*(1-r^2),0.16,0.94882,0.26147,0.17715),fw(0.115*r*cos(w)-0.01,0.2*r*sin(w),0.014+0.03*r^6-0.012*(1-r^2),11.6,(-0.26567),0.96406,0),r,0,1,w,0,2*pi) | ref=earL color=#edb9a3

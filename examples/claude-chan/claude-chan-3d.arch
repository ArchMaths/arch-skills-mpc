//Hair
# Hair shell around the head: th = angle from the crown, ph = angle from the front (+ toward her left),
# rr = radius factor. The cap covers the crown, sides and back; bangs are separate pointed strands.
hx(th,ph,rr)=1.06*rr*sin(th)*sin(ph)
hy(th,ph,rr)=0.03-1.1*rr*sin(th)*cos(ph)
hz(th,ph,rr)=12.0+1.12*rr*cos(th)
hp(k)=pi*(0.35*k+0.65*k^3)
hm(k)=1.05+1.45*sin(hp(k)/2)^2+0.75*exp(-((abs(hp(k))-1.2)/0.25)^2)
hg(s,k)=0.985+0.012*s*sin(30*hp(k))
(hx(s*hm(k),hp(k),hg(s,k)),hy(s*hm(k),hp(k),hg(s,k)),hz(s*hm(k),hp(k),hg(s,k)),s,0,1,k,(-1),1) | ref=hairCap color=#e2671d
# A bang strand runs from the crown (angle a0, azimuth p0) to its tip (a1, p1) with width wd; its
# cross-section is a lens, and its tip curls in by cu. t runs root to tip, w around the strand.
sth(t,a0,a1)=a0+(a1-a0)*t
sph(t,w,a0,a1,p0,p1,wd)=p0+(p1-p0)*t^1.5+wd*(1-t)^0.7*(0.5+t)*cos(w)/max(0.35,sin(sth(t,a0,a1)))
srr(t,w,cu)=1+0.07*(1-t)^0.3*sin(w)-cu*t^3
(hx(sth(t,0.3,1.88),sph(t,w,0.3,1.88,0.25,(-0.02),0.17),srr(t,w,0.0791)),hy(sth(t,0.3,1.88),sph(t,w,0.3,1.88,0.25,(-0.02),0.17),srr(t,w,0.0791)),hz(sth(t,0.3,1.88),sph(t,w,0.3,1.88,0.25,(-0.02),0.17),srr(t,w,0.0791)),w,0,2*pi,t,0,1) | ref=bang1 color=#e2671d

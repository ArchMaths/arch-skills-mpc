# Chrysanthemum: petal layers fa/fb/fc in local coordinates (r 0..1 out from the centre, w around),
# n petals of length R, cupped upward by cu, turned by ro; a ridge runs along each petal.
fpr(w,n,ro)=abs(cos(n*(w-ro)/2))^0.7
fa(r,w,n,sz,ro)=sz*r*(0.28+0.72*fpr(w,n,ro))*cos(w)
fb(r,w,n,sz,ro)=sz*r*(0.28+0.72*fpr(w,n,ro))*sin(w)
fc(r,w,n,sz,cu,ro)=sz*(cu*r^2+0.07*r*fpr(w,n,ro)^3)

# ---- hair ----
# A lock is a ribbon around its centre line; lcs(w) is its cross-section across the
# thickness: flat underneath, three faint ridges on top.
lcs(w)=(0.65*sin(w)+0.35*abs(sin(w)))*(0.86+0.14*cos(2*pi*cos(w)))
# The hair cap: a shell around the skull, taken around a pole at the parting
# (a: angle from the pole, f: around it, 0 toward the face).  ca(f) is how far it
# reaches from the pole: down to the hairline, above the ears and to the nape.
# Its radius is a superquadric with a semi-axis in each direction, grooved like
# combed hair, the grooves fading toward the pole.
ca(f)=1.3937+(-0.7733)*cos(f)+0.0703*sin(f)+(-0.0407)*cos(2*f)+(-0.0139)*sin(2*f)+0.0203*cos(3*f)+(-0.007)*sin(3*f)+(-0.0029)*cos(4*f)+(-0.0026)*sin(4*f)+0.0115*cos(5*f)+0.0031*sin(5*f)+0.0024*cos(6*f)+(-0.0016)*sin(6*f)+(-0.0059)*cos(7*f)+0.0024*sin(7*f)+0.0032*cos(8*f)+(-0.0013)*sin(8*f)
cdx(s,f)=0.96128*(sin(s*ca(f))*cos(f))+0.27559*(cos(s*ca(f)))
cdy(s,f)=0.01999*(sin(s*ca(f))*cos(f))+0.99736*(sin(s*ca(f))*sin(f))+(-0.06974)*(cos(s*ca(f)))
cdz(s,f)=(-0.27486)*(sin(s*ca(f))*cos(f))+0.07255*(sin(s*ca(f))*sin(f))+0.95874*(cos(s*ca(f)))
cq(s,f)=1/(((max(cdx(s,f),0)*1.0101)^2.3+(max(-(cdx(s,f)),0)*0.92593)^2.3+(max(cdy(s,f),0)*0.95238)^2.3+(max(-(cdy(s,f)),0)*0.89286)^2.3)^1.30435+(max(cdz(s,f),0)*0.59524)^3+(max(-(cdz(s,f)),0)*1.25)^3)^0.33333
cr(s,f)=(1-0.015*s^0.7*(1-abs(sin(9*f))^0.4))*cq(s,f)
surface((-0.1514)+cr(s,f)*(0.9944*(sin(s*ca(f))*cos(f))+(-0.0126)*(sin(s*ca(f))*sin(f))+0.10492*(cos(s*ca(f)))),(-0.18307)+cr(s,f)*(0.04113*(sin(s*ca(f))*cos(f))+0.96071*(sin(s*ca(f))*sin(f))+(-0.27447)*(cos(s*ca(f)))),0.01126+cr(s,f)*((-0.09734)*(sin(s*ca(f))*cos(f))+0.27725*(sin(s*ca(f))*sin(f))+0.95585*(cos(s*ca(f)))),s,0,1,f,(-3.14159),(-2.0944)) | color=#d27043

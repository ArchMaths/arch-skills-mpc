@title Claude Chan - natural smile
# The head radius along the direction (p,q,w): soft unions and intersections of
# superquadrics, a cylinder (the neck) and half-spaces, times exp(sum of bumps).
hr(p,q,w)=exp((-0.025)*exp(-((((abs(q)/max(p,0.0001)+1000*max(-p,0))-0.435)*7.14286)^2+((w/max(p,0.0001)-(-0.16))*10)^2))+0.05*exp(-((((q/max(p,0.0001)+1000*max(-p,0))*25)^2+((w/max(p,0.0001)-(-0.38))*(19.84127+(-8.73016)*sign((w/max(p,0.0001)-(-0.38)))))^2+0.01)^0.8-0.02512))+0.03*exp(-((((abs(q)/max(p,0.0001)+1000*max(-p,0))-0.5)*4.34783)^2+((w/max(p,0.0001)-(-0.37))*5.55556)^2))+0.015*exp(-(((q/max(p,0.0001)+1000*max(-p,0))*5.88235)^2+((w/max(p,0.0001)-(-0.65))*10)^2))+0.05*exp(-(((q/max(p,0.0001)+1000*max(-p,0))*4.54545)^2+((w/max(p,0.0001)-(-1.45))*3.125)^2))+(-0.01)*exp(-(((q/max(p,0.0001)+1000*max(-p,0))*9.52381)^2+((w/max(p,0.0001)-(-0.77))*20)^2)))/((((((max(p,0)*1.08696)^2.15+(max(-p,0)*1.11111)^2.15+(abs(q)*1.20482)^2.15)^1.16279+(max(w,0)*0.76923)^2.5+(max(-w,0)*2.38095)^2.5)^(-5.6)+((((max(p,0)*1.11111)^2.3+(max(-p,0)*4)^2.3+(abs(q)*1.6129)^2.3)^1.3913+(max(w,0)*3.33333)^3.2+(max(-w,0)*1.0989)^3.2)^5+max(1.06383*q+(-1.08511)*w,0)^16+max((-1.06383)*q+(-1.08511)*w,0)^16+max((-0.99471)*p+(-1.77947)*w,0)^16)^(-14/16))^1+(((sqrt(((-1.66131)*p+0.20398*w)^2-(10.94609*p^2+(-2.68802)*p*w+11.11111*q^2+0.16502*w^2)*(-0.747859))-((-1.66131)*p+0.20398*w))*1.337151)^40+max((-0.64516)*w,0)^40+max(5*w,0)^40)^(-14/40))^(-1/14))
# the head as a cube-sphere: six cube faces, each cut into the same grid of tiles
surface((-0.1514)+hr(1,u,v)*(0.98481+(-0.17365)*v),(-0.18307)+hr(1,u,v)*((-0.0361)+0.97815*u+(-0.20475)*v),0.01126+hr(1,u,v)*(0.16985+0.20791*u+0.96329*v),u,(-1),(-0.5),v,(-1),(-0.5)) | color=#fbe4d6

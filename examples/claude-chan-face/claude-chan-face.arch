# The face is drawn on the skin of the front face, D = (1,a,b).  Each region gets its
# own copy of hr without the parts that are negligible there (he: eyes and brows,
# hc: cheeks, hm: mouth), and de, dc, dm lift it by the fraction c.
he(a,b)=exp((-0.025)*exp(-(((abs(a)-0.435)*7.14286)^2+((b-(-0.16))*10)^2))+0.05*exp(-(((a*25)^2+((b-(-0.38))*(19.84127+(-8.73016)*sign((b-(-0.38)))))^2+0.01)^0.8-0.02512))+0.02*exp(-(((abs(a)-0.5)*4.34783)^2+((b-(-0.4))*5.55556)^2)))/((((1.19634+(abs(a)*1.20482)^2.15)^1.16279+(max(b,0)*0.76923)^2.5+(max(-b,0)*2.38095)^2.5)^(-5.6)+(((1.27421+(abs(a)*1.6129)^2.3)^1.3913+(max(b,0)*3.33333)^3.2+(max(-b,0)*1.0989)^3.2)^5+max(1.06383*a+(-1.08511)*b,0)^16+max((-1.06383)*a+(-1.08511)*b,0)^16)^(-14/16))^(-1/14))
de(a,b,c)=he(a,b)*(1+c)

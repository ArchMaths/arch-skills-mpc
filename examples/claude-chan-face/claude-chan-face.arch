dc(a,b,c)=hc(a,b)*(1+c)
hm(a,b)=exp(0.02*exp(-(((abs(a)-0.5)*4.34783)^2+((b-(-0.4))*5.55556)^2))+0.015*exp(-((a*5.88235)^2+((b-(-0.65))*10)^2))+0.05*exp(-((a*4.54545)^2+((b-(-1.45))*3.125)^2))+(-0.01)*exp(-((a*9.52381)^2+((b-(-0.77))*20)^2)))/((((1.19634+(abs(a)*1.20482)^2.15)^1.16279+(max(b,0)*0.76923)^2.5+(max(-b,0)*2.38095)^2.5)^(-5.6)+(((1.27421+(abs(a)*1.6129)^2.3)^1.3913+(max(b,0)*3.33333)^3.2+(max(-b,0)*1.0989)^3.2)^5+max(1.06383*a+(-1.08511)*b,0)^16+max((-1.06383)*a+(-1.08511)*b,0)^16)^(-14/16))^(-1/14))

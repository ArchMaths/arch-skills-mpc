# The face is drawn on the skin of the front face, D = (1,a,b).  Each region gets its
# own copy of hr without the parts that are negligible there (he: eyes and brows,
# hc: cheeks, hm: mouth), and de, dc, dm lift it by the fraction c.
he(a,b)=exp((-0.025)*exp(-(((abs(a)-0.39)*7.14286)^2+((b-(-0.16))*10)^2))+0.05*exp(-(((a*25)^2+((b-(-0.42))*(19.84127+(-8.73016)*sign((b-(-0.42)))))^2+0.01)^0.8-0.02512))+0.02*exp(-(((abs(a)-0.5)*4.34783)^2+((b-(-0.4))*5.55556)^2)))/((((1.19634+(abs(a)*1.20482)^2.15)^0.93023+(max(b,0)*1.08696)^2+(max(-b,0)*1.51515)^2)^(-12)+(((1.27421+(abs(a)*1.35135)^2.3)^1.3913+(max(b,0)*3.33333)^3.2+(max(-b,0)*1.0989)^3.2)^3.75+max(0.78393*a+(-1.05929)*b,0)^12+max((-0.78393)*a+(-1.05929)*b,0)^12)^(-2))^(-1/24))
de(a,b,c)=he(a,b)*(1+c)
hc(a,b)=exp((-0.025)*exp(-(((abs(a)-0.39)*7.14286)^2+((b-(-0.16))*10)^2))+0.02*exp(-(((abs(a)-0.5)*4.34783)^2+((b-(-0.4))*5.55556)^2))+0.015*exp(-((a*5.88235)^2+((b-(-0.68))*10)^2)))/((((1.19634+(abs(a)*1.20482)^2.15)^0.93023+(max(b,0)*1.08696)^2+(max(-b,0)*1.51515)^2)^(-12)+(((1.27421+(abs(a)*1.35135)^2.3)^1.3913+(max(b,0)*3.33333)^3.2+(max(-b,0)*1.0989)^3.2)^3.75+max(0.78393*a+(-1.05929)*b,0)^12+max((-0.78393)*a+(-1.05929)*b,0)^12)^(-2))^(-1/24))
dc(a,b,c)=hc(a,b)*(1+c)
hm(a,b)=exp(0.02*exp(-(((abs(a)-0.5)*4.34783)^2+((b-(-0.4))*5.55556)^2))+0.015*exp(-((a*5.88235)^2+((b-(-0.68))*10)^2))+0.05*exp(-((a*4.54545)^2+((b-(-1.45))*3.125)^2))+(-0.01)*exp(-((a*9.52381)^2+((b-(-0.8))*20)^2)))/((((1.19634+(abs(a)*1.20482)^2.15)^0.93023+(max(b,0)*1.08696)^2+(max(-b,0)*1.51515)^2)^(-12)+(((1.27421+(abs(a)*1.35135)^2.3)^1.3913+(max(b,0)*3.33333)^3.2+(max(-b,0)*1.0989)^3.2)^3.75+max(0.78393*a+(-1.05929)*b,0)^12+max((-0.78393)*a+(-1.05929)*b,0)^12)^(-2))^(-1/24))
dm(a,b,c)=hm(a,b)*(1+c)

# JavaScript operators, frame-by-frame steps, canvas text and a global script.
@title Steps of a construction

# A JavaScript operator, used like any built-in function below.
@operator clamp(v, lo, hi)
  return Math.min(hi, Math.max(lo, v));
@end
sq(u)={ return u*u; }

a=1                     | min=0 max=3 step=0.01
y=clamp(2*sin(x),-1,1)  | ref=wave color=blue thickness=4
point(P,wave,a)         | color=red

# Frame-by-frame: frame 0 shows everything; frame N shows only objects with frame=N or 0.
@frames total=3 fps=1
point(L,-3,-2)          | frame=1
point(R,-1,-2)          | frame=1
segment(s,L,R)          | frame=2 color=green
circle(c,L,R)           | frame=3 color=orange

# Canvas text (top-left corner in graph coordinates). {value(...)} makes it live.
@text x=-4.5 y=3.6 size=0.45 color=indigo | Construction steps
@text x=0.5 y=-1.2 size=0.35 | P = ({value(a)}, {value(clamp(2*sin(a),-1,1))})\nsq(a) = {value(sq(a))}

# Stored global program; Arch runs it when the user presses Run.
@script
let t = 0;
setInterval(() => {
  t += 0.03;
  arch.valuesetting('a', 1.5 + 1.5 * Math.sin(t));
}, 30);
@end

@view x=-5..5 y=-3..4
